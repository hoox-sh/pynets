{
  "name": "@hoox/pynets",
  "version": "0.1.0",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "author": "jango_blockchained",
  "description": "PyneTS — TypeScript / Bun Pine Script library (parse, unparse, interpret, stream). Python pynescript Runtime remains the source of truth.",
  "keywords": [
    "pine-script",
    "pinescript",
    "tradingview",
    "runtime",
    "interpreter",
    "backtest",
    "indicator",
    "strategy",
    "ohlcv",
    "typescript",
    "bun"
  ],
  "homepage": "https://github.com/hoox-sh/pynets",
  "bugs": {
    "url": "https://github.com/hoox-sh/pynets/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hoox-sh/pynets.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "src",
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "browser": "./dist/browser.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "pynets": "./src/cli.ts"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=20"
  },
  "scripts": {
    "generate": "bun run scripts/generate-antlr.ts",
    "build": "bun run scripts/build.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "pynets": "bun run src/cli.ts",
    "pack:check": "bun run build && npm pack --dry-run",
    "prepack": "bun run build"
  },
  "dependencies": {
    "antlr4": "4.13.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "typescript": "^5.9.3"
  }
}
